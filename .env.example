# Google reviews for the testimonials section (Places API (New)).
# Create a key in Google Cloud with "Places API (New)" enabled. Without it the
# site shows the shop's Facebook recommendations instead.
GOOGLE_PLACES_API_KEY=

# Optional: defaults to the Pizza Piatto listing (ChIJaRaBSGkvdTERkkyYbGdB03Q)
GOOGLE_PLACE_ID=

# The site's public address, used in email links (View My Reservations,
# Open the Reservation Desk) and share previews, e.g. https://www.example.com.
# On Vercel it defaults to the production domain; anywhere else, set it, or
# the links in emails point at localhost.
NEXT_PUBLIC_SITE_URL=

# ---------- Reservations ----------

# Signs the staff and guest sign-in cookies and the one-time codes. Required
# in production. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Password for the staff reservation desk at /en/admin (or /vi/admin).
ADMIN_PASSWORD=

# Where bookings are stored. Leave empty to use a JSON file in .data/
# (local development or a single long-running server). Vercel's filesystem is
# read-only, so deploys there need Upstash Redis (free tier is plenty; the
# Vercel Marketplace integration fills in KV_REST_API_URL / KV_REST_API_TOKEN,
# which work too).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Outgoing email (guest tickets, the shop's receipts, sign-in codes).
# Gmail: turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# Without SMTP, development saves each email as an .html file in .data/outbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional, defaults to "Pizza Piatto" <SMTP_USER>. Gmail only sends from the
# signed-in address (or an alias set up in Gmail).
MAIL_FROM=

# Optional: inbox for new-booking receipts. Defaults to the demo inbox in
# src/lib/restaurant.js (bookingInbox).
RESERVATION_INBOX=

# Sign-in codes by SMS for "my reservations" (Twilio Verify). Without these,
# codes are emailed to the address on the guest's bookings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Shows sign-in codes on screen instead of requiring SMS/email. On by default
# in development; never enable it in production with real guests, as anyone
# could then read anyone's bookings.
OTP_DEMO_MODE=

# "Load / clear sample bookings" on the reservation desk. On in development;
# set to true only on a demo deployment, never on the shop's live site.
DEMO_TOOLS=

# ---------- Pizza classes: payments ----------

# Who takes payment for class bookings: "payos" or "mock". Leave empty to
# use PayOS once its three keys below are set, and otherwise the built-in
# test checkout in development (no real money). In production without
# PayOS, online class payment is switched off and the class page asks
# students to call. Set "mock" only on a demo site, never on the live shop.
PAYMENT_PROVIDER=

# PayOS (https://payos.vn), VietQR bank-transfer checkout. From the PayOS
# dashboard: create a payment channel, copy its Client ID, API Key and
# Checksum Key, and set its webhook URL to
#   https://<your domain>/api/payments/webhook/payos
# Refunds are bank transfers the shop sends itself; the Class Desk lists
# them under "Refunds to send".
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Photos for class recaps. Vercel's disk is read-only, so deploys there need
# a Vercel Blob store (Storage -> Blob; it fills this in). Without it,
# photos are kept in .data/uploads.
BLOB_READ_WRITE_TOKEN=

# Optional scheduled sweep (e.g. Vercel Cron calling /api/cron/reconcile
# every few minutes): releases lapsed seat holds and asks the payment
# provider about payments whose webhook never arrived. Without it the same
# checks run whenever a ticket or the Class Desk is open. Any long random
# string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
