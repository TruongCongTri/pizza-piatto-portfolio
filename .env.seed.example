# Settings for docker-compose.seed.yml (copying .data/ to the deployed site's
# Upstash Redis). Copy this file to .env.seed and fill it in; .env.seed stays
# out of git.

# An access token: vercel.com/account/tokens
VERCEL_TOKEN=

# The team (or personal account) and the project: Project Settings -> General
# shows the Project ID, Team Settings shows the Team ID (for a personal
# account, the user ID under Account Settings). `vercel link` also writes both
# to .vercel/project.json as "orgId" and "projectId".
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Which of the project's environments to read the Upstash credentials from
VERCEL_ENVIRONMENT=production

# Extra options for the copy, e.g. --no-samples (leave out sample bookings)
# or --only=workshops,reservations
SEED_ARGS=

# 1 = show what would be copied and stop
DRY_RUN_ONLY=0
